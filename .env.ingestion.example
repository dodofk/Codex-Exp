# Environment variables used by ingestion scripts (do not commit real secrets).

# Required when downloading MuST-C artifacts protected by FBK SSO.
MUSTC_TOKEN=your_fbk_token_here

# Optional cookie header for VoxPopuli mirrors that require authentication.
VOXPOPULI_COOKIE=your_cookie_header_here

# YouTube-derived datasets may require an API key to avoid rate limits.
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional: personal access token for private Hugging Face datasets.
HUGGINGFACE_TOKEN=hf_your_token_here

# Optional: mirror telemetry events to stdout for debugging (set to 1 to enable).
OTEL_EXPORTER_CONSOLE=0
